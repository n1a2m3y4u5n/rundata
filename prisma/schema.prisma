// RunData — 시민참여형 러닝 기반 현실세계 데이터 수집·정제 플랫폼
// SQLite는 enum을 지원하지 않으므로 문자열 필드 + src/lib/constants.ts 상수로 관리한다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// 사용자: 러너 / 의뢰사 / 관리자
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("RUNNER") // RUNNER | CLIENT | ADMIN
  createdAt DateTime @default(now())

  // 의뢰사 전용
  orgName String?

  // 러너 전용 프로필/체력
  avgSpeed      Float @default(2.6) // m/s (약 6'25"/km)
  totalDistance Float @default(0) // 누적 주행 거리(m)
  fitnessLevel  Float @default(50) // 0~100 추정 체력 지수
  creditBalance Int   @default(0) // 보유 크레딧(원)

  requests    Request[]
  routes      Route[]
  runSessions RunSession[]
  submissions Submission[]
  rewards     RewardTransaction[]
  badges      Badge[]
}

/// 의뢰: 의뢰사가 등록하는 데이터 요청
model Request {
  id          String   @id @default(cuid())
  clientId    String
  client      User     @relation(fields: [clientId], references: [id])
  title       String
  description String
  dataType    String // IMAGE | OBSERVATION | EXPERIENCE
  areaLat     Float // 대상 지역 중심
  areaLng     Float
  areaRadius  Int // m
  rewardPerItem Int // 항목당 단가(원)
  targetCount   Int // 목표 수집 건수
  prepayment    Int // 선입금(원) = rewardPerItem * targetCount 기반
  status        String   @default("ACTIVE") // DRAFT | ACTIVE | COMPLETED
  deadline      DateTime?
  createdAt     DateTime @default(now())

  missions Mission[]
  datasets Dataset[]
}

/// 미션: 오케스트레이션 엔진이 의뢰를 변환해 생성한 개별 수집 지점
model Mission {
  id          String   @id @default(cuid())
  requestId   String
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  lat         Float
  lng         Float
  instruction String
  dataType    String // IMAGE | OBSERVATION | EXPERIENCE
  priority    Int      @default(3) // 1(낮음)~5(높음)
  reward      Int
  status      String   @default("OPEN") // OPEN | ASSIGNED | COMPLETED | VERIFIED | REJECTED
  createdAt   DateTime @default(now())

  routes      Route[]      @relation("RouteMissions")
  submissions Submission[]
}

/// 추천 경로: 경로 추천 엔진 산출물
model Route {
  id             String   @id @default(cuid())
  runnerId       String
  runner         User     @relation(fields: [runnerId], references: [id])
  polyline       String // JSON [[lat,lng], ...]
  distance       Float // m
  estDuration    Int // s
  targetTime     Int // 사용자가 입력한 목표 시간(분)
  targetDistance Float // 사용자가 입력한 목표 거리(m)
  workoutScore   Float
  missionScore   Float
  safetyScore    Float
  status         String   @default("SUGGESTED") // SUGGESTED | ACTIVE | DONE
  createdAt      DateTime @default(now())

  missions   Mission[]    @relation("RouteMissions")
  runSession RunSession?
}

/// 실제 주행 세션
model RunSession {
  id                String   @id @default(cuid())
  runnerId          String
  runner            User     @relation(fields: [runnerId], references: [id])
  routeId           String?  @unique
  route             Route?   @relation(fields: [routeId], references: [id])
  startedAt         DateTime @default(now())
  endedAt           DateTime?
  distance          Float    @default(0) // m
  duration          Int      @default(0) // s
  trackPoints       String   @default("[]") // JSON [[lat,lng,t], ...]
  avgPace           Float    @default(0) // s/km
  intervalCount     Int      @default(0)
  missionsCompleted Int      @default(0)

  submissions Submission[]
}

/// 러너가 미션 지점에서 수집·업로드한 데이터
model Submission {
  id             String   @id @default(cuid())
  missionId      String
  mission        Mission  @relation(fields: [missionId], references: [id])
  runnerId       String
  runner         User     @relation(fields: [runnerId], references: [id])
  runSessionId   String?
  runSession     RunSession? @relation(fields: [runSessionId], references: [id])
  photoData      String? // data URL(base64) — 데모용 로컬 저장
  maskedPhotoData String? // 개인정보 마스킹 후
  lat            Float
  lng            Float
  capturedAt     DateTime @default(now())
  observationData String? // JSON — OBSERVATION/EXPERIENCE 응답
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED
  qualityScore   Float    @default(0) // 0~100
  aiLabels       String? // JSON string[] — Claude Vision 자동 라벨
  piiRegions     String? // JSON [{x,y,w,h,kind}] — Claude Vision 개인정보 탐지 bbox(정규화 0~1). null=미분석
  gpsMatch       Boolean  @default(false)
  distanceM      Int      @default(0) // 미션 지점과의 GPS 거리(m)
  autoReviewed   Boolean  @default(false) // 알고리즘 자동 판정 여부
  rejectionReason String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())

  // ── 정책 환류 루프 ──────────────────────────────────────────────
  // 제보가 행정에서 실제로 어떻게 처리되었는지를 러너에게 되돌려주기 위한 상태.
  // 보상만으로는 참여가 지속되지 않으며, 자신이 지나친 자리가 고쳐졌다는 확인이
  // 가장 강한 유인이다.
  policyStatus    String    @default("RECEIVED") // RECEIVED | INSPECTING | RESOLVED
  policyNote      String? // 담당 부서 회신 메모
  policyUpdatedAt DateTime?

  reward RewardTransaction?
}

/// 보상 거래 내역
model RewardTransaction {
  id           String   @id @default(cuid())
  runnerId     String
  runner       User     @relation(fields: [runnerId], references: [id])
  submissionId String?  @unique
  submission   Submission? @relation(fields: [submissionId], references: [id])
  type         String // BASE_CREDIT | PERFORMANCE_BONUS | REDEMPTION
  amount       Int // 원 (REDEMPTION은 음수)
  description  String
  createdAt    DateTime @default(now())
}

/// 데이터셋: 검수 완료 데이터를 패키징해 의뢰사에 납품
model Dataset {
  id          String   @id @default(cuid())
  requestId   String
  request     Request  @relation(fields: [requestId], references: [id])
  name        String
  itemCount   Int
  manifest    String // JSON 매니페스트
  status      String   @default("BUILDING") // BUILDING | DELIVERED
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
}

/// 게이미피케이션 배지
model Badge {
  id       String   @id @default(cuid())
  runnerId String
  runner   User     @relation(fields: [runnerId], references: [id])
  type     String // FIRST_MISSION | STREAK | TOP_CONTRIBUTOR | AREA_HERO ...
  earnedAt DateTime @default(now())

  @@unique([runnerId, type])
}
